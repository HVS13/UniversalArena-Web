{
  "name": "universal-arena-web",
  "private": true,
  "version": "0.2.0-friend-alpha",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --filter @ua/client dev",
    "build": "pnpm --filter @ua/client build",
    "preview": "pnpm --filter @ua/client preview",
    "data:validate": "node packages/data/validate-manifest.mjs",
    "privacy": "tsx apps/client/src/relay-protocol.golden.ts",
    "golden": "pnpm --filter @ua/core golden",
    "harness": "pnpm --filter @ua/core harness",
    "release:check": "pnpm data:validate && pnpm privacy && pnpm golden && pnpm harness && pnpm build && pnpm --dir server test"
  },
  "devDependencies": {
    "tsx": "^4.8.1"
  }
}
